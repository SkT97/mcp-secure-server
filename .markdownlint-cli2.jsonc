{
  "config": {
    "MD013": false,
    "MD033": {
      "allowed_elements": [
        "details",
        "summary",
        "strong",
        "picture",
        "source",
        "img"
      ]
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    ".venv/**",
    ".pytest_cache/**",
    ".ruff_cache/**",
    "dist/**"
  ]
}
